        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({p_id:$json.id,p_lease_token:$json.lease_token,p_success:$json.success,p_provider_id:$json.provider_id,p_transient:$json.transient,p_error:$json.error,p_retry_after_seconds:$json.retry_after_seconds}) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "INQUIRYFLOW_SUPABASE",
          "name": "InquiryFlow Supabase"
        }
      }
    }
  ],
