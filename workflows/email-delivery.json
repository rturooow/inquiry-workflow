      "position": [
        5280,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b86e0a1d-d415-45fb-9fa3-8a82d5d4a119",
              "leftValue": "={{ $json.body?.allowed === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "bbb40593-b1d1-4bd9-84df-ad6246dc8b08",
      "name": "Send email via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        5520,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.event_key }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body.payload) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "id": "INQUIRYFLOW_RESEND",
          "name": "InquiryFlow Resend"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "6073c631-4bec-40e8-bd04-5860eb4333d6",
      "name": "Classify delivery result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5760,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const a=$('Authorize email send').item.json.body;const r=$json||{};const s=Number(r.statusCode||0);const b=r.body||{};\nconst success=s>=200&&s<300&&typeof b.id==='string'&&b.id.length>0;const transient=!success&&(s===0||s===408||s===429||s>=500||(s===409&&b.name==='concurrent_idempotent_requests'));\nconst h=r.headers?.['retry-after'];const n=Number(h);const retry=h==null?0:Number.isFinite(n)?n:Math.ceil((Date.parse(h)-Date.now())/1000);\nreturn [{json:{id:a.id,lease_token:a.lease_token,success,provider_id:success?b.id:null,transient,error:success?null:s?'Resend HTTP '+s+(b.name?' ('+String(b.name).slice(0,100)+')':''):'Transport error; outcome unknown',retry_after_seconds:Number.isFinite(retry)?Math.max(0,Math.min(86400,Math.ceil(retry))):0}}];"
      }
    },
    {
      "id": "86280a8f-ebeb-437e-be31-11bbb776171b",
      "name": "Record email result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
