    {
      "id": "42bd88fe-a1e1-4472-b25b-bf279badd799",
      "name": "Split claimed emails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4800,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const jobs=$json.body?.jobs;return Array.isArray(jobs)?jobs.map(job=>({json:job})):[];"
